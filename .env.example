# Core
APP_ENV=development
APP_NAME=ContextOps
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# PostgreSQL + pgvector
DATABASE_URL=postgresql+asyncpg://nexus:nexus@db:5432/nexusai
AUTO_SEED=true

# LLM mode: hybrid | gemini | ollama | mock
# hybrid keeps routing/validation deterministic and uses the providers below only for generation.
LLM_PROVIDER=hybrid
HYBRID_PRIMARY=ollama

# Gemini (primary or fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_COOLDOWN_SECONDS=65
GEMINI_FALLBACK_ENABLED=true

# Ollama local fallback (free, no request quota)
OLLAMA_ENABLED=true
OLLAMA_FALLBACK_ENABLED=true
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=90
OLLAMA_KEEP_ALIVE=10m

# Local embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
TOP_K=5
MIN_SIMILARITY=0.20
EMBEDDING_BATCH_SIZE=64

# Retrieval / ingestion
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MAX_UPLOAD_MB=10

# Safety
MAX_SQL_ROWS=100
